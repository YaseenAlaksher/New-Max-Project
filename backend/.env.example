NODE_ENV=production
PORT=3001
STORE_NAME=PHI
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
DB_PATH=./newmax.db
TOKEN_TTL=7d
LOGIN_RATE_LIMIT=20
ORDER_RATE_LIMIT=20
LOW_STOCK_THRESHOLD=5

# Optional Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=phi-products


# Commercial notifications
ADMIN_EMAIL=orders@example.com
EMAIL_FROM=PHI <orders@example.com>
EMAIL_WEBHOOK_URL=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
